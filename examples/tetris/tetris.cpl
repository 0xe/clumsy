// Tetris in Clumsy — refactored with ||, &&, break, continue
(extern SDL_Init [int] int)
(extern SDL_CreateWindow [(* char) int int int int int] (* void))
(extern SDL_CreateRenderer [(* void) int int] (* void))
(extern SDL_SetRenderDrawColor [(* void) int int int int] int)
(extern SDL_RenderClear [(* void)] int)
(extern SDL_RenderPresent [(* void)] void)
(extern SDL_RenderFillRect [(* void) (* void)] int)
(extern SDL_PollEvent [(* void)] int)
(extern SDL_PumpEvents [] void)
(extern SDL_DestroyRenderer [(* void)] void)
(extern SDL_DestroyWindow [(* void)] void)
(extern SDL_Delay [int] void)
(extern SDL_Quit [] void)
(extern printf [(* char) int] int)

(let COLS int 10)
(let ROWS int 20)
(let CS int 32)
(let WW int 320)
(let WH int 640)
(let DROP int 30)
(let SDL_I int 0x20)
(let WP int 0x1FFF0000)
(let EQ int 0x100)
(let EK int 0x300)
(let KL int 0x40000050)
(let KR int 0x4000004F)
(let KD int 0x40000051)
(let KU int 0x40000052)
(let KE int 0x1B)

// Colors
(let CR int[7] [0   255 128 0   255 0   255])
(let CG int[7] [255 255 0   255 0   0   165])
(let CB int[7] [255 0   128 0   0   255 0  ])

// Shapes: kind*32 + rot*8 + cell*2 = {x,y}
(let SH int[224] [
  0 1 1 1 2 1 3 1   2 0 2 1 2 2 2 3   0 2 1 2 2 2 3 2   1 0 1 1 1 2 1 3
  1 0 2 0 1 1 2 1   1 0 2 0 1 1 2 1   1 0 2 0 1 1 2 1   1 0 2 0 1 1 2 1
  1 0 0 1 1 1 2 1   1 0 1 1 2 1 1 2   0 1 1 1 2 1 1 2   1 0 0 1 1 1 1 2
  1 0 2 0 0 1 1 1   1 0 1 1 2 1 2 2   1 1 2 1 0 2 1 2   0 0 0 1 1 1 1 2
  0 0 1 0 1 1 2 1   2 0 1 1 2 1 1 2   0 1 1 1 1 2 2 2   1 0 0 1 1 1 0 2
  0 0 0 1 1 1 2 1   1 0 2 0 1 1 1 2   0 1 1 1 2 1 2 2   1 0 1 1 0 2 1 2
  2 0 0 1 1 1 2 1   1 0 1 1 1 2 2 2   0 1 1 1 2 1 0 2   0 0 1 0 1 1 1 2
])

// State
(let window (* void) 0)
(let renderer (* void) 0)
(let board int[200] [0])
(let pk int 0)
(let pr int 0)
(let ppx int 0)
(let ppy int 0)
(let score int 0)
(let over int 0)
(let timer int 0)
(let ev int[7] [0])
(let rc int[2] [0])

// Cell positions
(let cx int[4] [0 0 0 0])
(let cy int[4] [0 0 0 0])

// Temp vars
(let base int 0)
(let _i int 0)
(let _ok int 0)
(let _nx int 0)
(let _ny int 0)

// Helper: check if position is blocked (out of bounds or occupied)
(let blocked (fn [(x int) (y int)] int
  (if (|| (< x 0) (|| (>= x COLS) (|| (< y 0) (>= y ROWS))))
    (ret 1)
    (if (> board[(+ (* y COLS) x)] 0) (ret 1) (ret 0)))))

// Helper: check if position is in bounds
(let in_bounds (fn [(x int) (y int)] int
  (ret (&& (&& (>= x 0) (< x COLS)) (&& (>= y 0) (< y ROWS))))))

// Helper: move piece by dx, dy if not blocked
(let try_move (fn [(dx int) (dy int)] int
  (set _ok 1)
  (set _i 0)
  (while (< _i 4)
    (begin
      (set _nx (+ cx[_i] dx))
      (set _ny (+ cy[_i] dy))
      (if (blocked _nx _ny) (set _ok 0))
      (set _i (+ _i 1))
    ))
  (if (= _ok 0) (ret 0))
  (set _i 0)
  (while (< _i 4)
    (begin
      (set cx[_i] (+ cx[_i] dx))
      (set cy[_i] (+ cy[_i] dy))
      (set _i (+ _i 1))
    ))
  (set ppx (+ ppx dx))
  (set ppy (+ ppy dy))
  (ret 1)))

// Helper: update cell positions from ppx/ppy and shape data
(let update_cells (fn [] void
  (set base (+ (* pk 32) (* pr 8)))
  (set _i 0)
  (while (< _i 4)
    (begin
      (set cx[_i] (+ ppx SH[(+ base (* _i 2))]))
      (set cy[_i] (+ ppy SH[(+ base (+ (* _i 2) 1))]))
      (set _i (+ _i 1))
    ))))

// Helper: spawn new piece
(let spawn (fn [] void
  (set pk (% (+ score timer) 7))
  (set pr 0)
  (set ppx 3)
  (set ppy 0)
  (update_cells)))

// Helper: lock piece to board
(let lock (fn [] void
  (set _i 0)
  (while (< _i 4)
    (begin
      (if (in_bounds cx[_i] cy[_i])
        (set board[(+ (* cy[_i] COLS) cx[_i])] (+ pk 1)))
      (set _i (+ _i 1))
    ))))

// Helper: clear completed lines, return number cleared
(let clear_lines (fn [] int
  (let cleared int 0)
  (let ri int (- ROWS 1))
  (while (>= ri 0)
    (begin
      (let full int 1)
      (let ci2 int 0)
      (while (< ci2 COLS)
        (begin
          (if (= board[(+ (* ri COLS) ci2)] 0) (set full 0))
          (set ci2 (+ ci2 1))
        ))
      (if (= full 1)
        (begin
          (set cleared (+ cleared 1))
          (let si int (- ri 1))
          (while (>= si 0)
            (begin
              (let sc int 0)
              (while (< sc COLS)
                (begin
                  (set board[(+ (* (+ si 1) COLS) sc)] board[(+ (* si COLS) sc)])
                  (set sc (+ sc 1))
                ))
              (set si (- si 1))
            ))
          (let tc int 0)
          (while (< tc COLS)
            (begin
              (set board[tc] 0)
              (set tc (+ tc 1))
            ))
        ))
      (set ri (- ri 1))
    ))
  (ret cleared)))

// Helper: check if game over (spawned piece overlaps)
(let check_game_over (fn [] int
  (set _i 0)
  (while (< _i 4)
    (begin
      (if (blocked cx[_i] cy[_i]) (ret 1))
      (set _i (+ _i 1))
    ))
  (ret 0)))

// Helper: handle key press
(let handle_key (fn [(kc int)] void
  (if (= kc KE) (set over 1))
  (if (= kc KL) (try_move -1 0))
  (if (= kc KR) (try_move 1 0))
  (if (= kc KD) (try_move 0 1))
  (if (= kc KU)
    (begin
      (let nr (% (+ pr 1) 4))
      (set _ok 1)
      (set _i 0)
      (let nbase (+ (* pk 32) (* nr 8)))
      (while (< _i 4)
        (begin
          (set _nx (+ ppx SH[(+ nbase (* _i 2))]))
          (set _ny (+ ppy SH[(+ nbase (+ (* _i 2) 1))]))
          (if (blocked _nx _ny) (set _ok 0))
          (set _i (+ _i 1))
        ))
      (if (= _ok 1)
        (begin
          (set pr nr)
          (update_cells)
        ))
    )))

// Main
(SDL_Init SDL_I)
(set window (SDL_CreateWindow "Clumsy Tetris" WP WP WW WH 4))

(if (= window 0)
  (printf "No window\n")
  (begin
    (set renderer (SDL_CreateRenderer window -1 0))
    (if (= renderer 0)
      (printf "No renderer\n")
      (begin
        (spawn)

        // GAME LOOP
        (while (= over 0)
          (begin
            (set timer (+ timer 1))

            // Poll events
            (SDL_PumpEvents)
            (let has int (SDL_PollEvent (& ev)))
            (while (= has 1)
              (begin
                (let etype (& ev[0] 0xFFFF))
                (if (= etype EQ) (set over 1))
                (if (= etype EK) (handle_key (>> ev[2] 32)))
                (set has (SDL_PollEvent (& ev)))
              ))

            // Gravity
            (if (= (% timer DROP) 0)
              (begin
                (if (= (try_move 0 1) 0)
                  (begin
                    (lock)
                    (let cleared int (clear_lines))
                    (set score (+ score (* cleared 10)))
                    (spawn)
                    (if (= (check_game_over) 0) 0 (set over 1))
                  ))
              ))

            // Render
            (SDL_PumpEvents)
            (SDL_SetRenderDrawColor renderer 30 30 30 255)
            (SDL_RenderClear renderer)

            // Board cells
            (let dr int 0)
            (while (< dr ROWS)
              (begin
                (let dc int 0)
                (while (< dc COLS)
                  (begin
                    (let cv int board[(+ (* dr COLS) dc)])
                    (if (> cv 0)
                      (begin
                        (let pi int (- cv 1))
                        (SDL_SetRenderDrawColor renderer CR[pi] CG[pi] CB[pi] 255)
                        (set rc[0] (+ (* dc CS) (<< (* dr CS) 32)))
                        (set rc[1] (+ CS (<< CS 32)))
                        (SDL_RenderFillRect renderer (& rc))
                      ))
                    (set dc (+ dc 1))
                  ))
                (set dr (+ dr 1))
              ))

            // Current piece
            (set _i 0)
            (while (< _i 4)
              (begin
                (if (in_bounds cx[_i] cy[_i])
                  (begin
                    (SDL_SetRenderDrawColor renderer CR[pk] CG[pk] CB[pk] 255)
                    (set rc[0] (+ (* cx[_i] CS) (<< (* cy[_i] CS) 32)))
                    (set rc[1] (+ CS (<< CS 32)))
                    (SDL_RenderFillRect renderer (& rc))
                  ))
                (set _i (+ _i 1))
              ))

            // Grid
            (SDL_SetRenderDrawColor renderer 50 50 50 255)
            (let gl int 0)
            (while (<= gl COLS)
              (begin
                (set rc[0] (+ (* gl CS) 0))
                (set rc[1] (+ 1 (<< WH 32)))
                (SDL_RenderFillRect renderer (& rc))
                (set gl (+ gl 1))
              ))
            (let gh int 0)
            (while (<= gh ROWS)
              (begin
                (set rc[0] (+ 0 (<< (* gh CS) 32)))
                (set rc[1] (+ WW (<< 1 32)))
                (SDL_RenderFillRect renderer (& rc))
                (set gh (+ gh 1))
              ))

            (SDL_RenderPresent renderer)
            (SDL_Delay 16)
          ))

        // Game over
        (SDL_SetRenderDrawColor renderer 0 0 0 200)
        (set rc[0] 0)
        (set rc[1] (+ WW (<< WH 32)))
        (SDL_RenderFillRect renderer (& rc))
        (SDL_RenderPresent renderer)
        (SDL_DestroyRenderer renderer)
        (SDL_DestroyWindow window)
        (SDL_Quit)
        (printf "Game over! Score: %d\n" score)
      ))
  ))
