// Simple TCP server using SDL_net
(extern SDL_Init [int] int)
(extern SDLNet_Init [] int)
(extern SDLNet_Quit [] void)
(extern SDLNet_ResolveHost [(* void) (* char) int] int)
(extern SDLNet_TCP_Open [(* void)] (* void))
(extern SDLNet_TCP_Accept [(* void)] (* void))
(extern SDLNet_TCP_Close [(* void)] void)
(extern SDLNet_TCP_Send [(* void) (* void) int] int)
(extern SDL_Delay [int] void)
(extern SDL_Quit [] void)

// Constants
(let SDL_INIT_VIDEO int 0)
(let PORT int 8080)

// State (declared at top level so build_symbol_table finds them)
(let sdl_result int 0)
(let net_result int 0)
(let ip int 0)
(let resolve_result int 0)
(let server_socket (* void) 0)

// Initialize systems
(set sdl_result (SDL_Init SDL_INIT_VIDEO))
(set net_result (SDLNet_Init))

(if (= net_result 0)
  (begin
    (print "TCP Server starting...")

    // Listen on all interfaces
    (set resolve_result (SDLNet_ResolveHost ip 0 PORT))

    (if (= resolve_result 0)
      (begin
        (set server_socket (SDLNet_TCP_Open ip))
        (if (not (= server_socket 0))
          (begin
            (print "Server listening on port 8080...")
            (print "In another terminal: run ./tcp_client")
            (print "Press Ctrl+C to stop server")

            (SDL_Delay 5000)

            (SDLNet_TCP_Close server_socket)
            (print "Server shut down")
          )
          (print "Failed to open server socket")
        )
      )
      (print "Failed to resolve host")
    )

    (SDLNet_Quit)
  )
  (print "SDLNet initialization failed")
)

(SDL_Quit)
