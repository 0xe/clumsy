// Tetris with C-interop - simplified to avoid struct-passing issues

(extern printf [(* char) int] int)
(extern SDL_Init [int] int)
(extern SDL_CreateWindow [(* char) int int int int int] (* void))
(extern SDL_CreateRenderer [(* void) int int] (* void))
(extern SDL_SetRenderDrawColor [(* void) int int int int] int)
(extern SDL_RenderClear [(* void)] int)
(extern SDL_RenderPresent [(* void)] void)
(extern SDL_DestroyRenderer [(* void)] void)
(extern SDL_DestroyWindow [(* void)] void)
(extern SDL_Delay [int] void)
(extern SDL_Quit [] void)

// Constants
(let BOARD_WIDTH int 10)
(let BOARD_HEIGHT int 20)
(let BLOCK_SIZE int 20)
(let SDL_INIT_VIDEO int 0x00000020)
(let SDL_WINDOW_SHOWN int 4)
(let SDL_WINDOWPOS_UNDEFINED int 0x1FFF0000)

// Game state
(let window (* void) 0)
(let renderer (* void) 0)

// Initialize SDL and create window
(SDL_Init SDL_INIT_VIDEO)
(set window (SDL_CreateWindow "Clumsy Tetris" SDL_WINDOWPOS_UNDEFINED SDL_WINDOWPOS_UNDEFINED (* BOARD_WIDTH BLOCK_SIZE) (* BOARD_HEIGHT BLOCK_SIZE) SDL_WINDOW_SHOWN))

(if (not (= window 0))
  (begin
    (set renderer (SDL_CreateRenderer window -1 0))
    (if (not (= renderer 0))
      (begin
        (printf "=== Tetris Game ===\n")
        (printf "Controls: Q to quit\n")

        // Black background
        (SDL_SetRenderDrawColor renderer 0 0 0 255)
        (SDL_RenderClear renderer)
        // White border
        (SDL_SetRenderDrawColor renderer 255 255 255 255)
        (SDL_RenderPresent renderer)
        (SDL_Delay 2000)

        (SDL_DestroyRenderer renderer)
      )
      (printf "Failed to create renderer\n")
    )
    (SDL_DestroyWindow window)
  )
  (printf "Failed to create window\n")
)

(SDL_Quit)
(printf "Game over!\n")
