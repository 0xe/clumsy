// SDL loop demo: opens a window and draws a cornflower-blue screen at ~60fps

(extern SDL_Init [int] int)
(extern SDL_CreateWindow [*char int int int int int] int)
(extern SDL_CreateRenderer [int int int] int)
(extern SDL_SetRenderDrawColor [int int int int int] int)
(extern SDL_RenderClear [int] int)
(extern SDL_RenderPresent [int] void)
(extern SDL_DestroyRenderer [int] void)
(extern SDL_DestroyWindow [int] void)
(extern SDL_Quit [] void)
(extern SDL_Delay [int] void)
(extern SDL_PumpEvents [] void)

(let SDL_INIT_VIDEO int 0x00000020)
(let SDL_WINDOWPOS_CENTERED int 0x2FFF0000)
(let SDL_WINDOW_SHOWN int 0x00000004)

(SDL_Init SDL_INIT_VIDEO)

(let window int (SDL_CreateWindow "Clumsy" SDL_WINDOWPOS_CENTERED SDL_WINDOWPOS_CENTERED 640 480 SDL_WINDOW_SHOWN))
(let renderer int (SDL_CreateRenderer window 0 0))

(let i int 0)
(while (< i 180)
  (begin
    (SDL_SetRenderDrawColor renderer 100 149 237 255)
    (SDL_RenderClear renderer)
    (SDL_RenderPresent renderer)
    (SDL_PumpEvents)
    (SDL_Delay 16)
    (set i (+ i 1))
  )
)

(SDL_DestroyRenderer renderer)
(SDL_DestroyWindow window)
(SDL_Quit)
