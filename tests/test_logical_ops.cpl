(print "=== Logical Operators Test ===\n")
(print "\n")

// || tests
(let a int 0)
(let b int 5)
(let r1 int (|| a b))
(print "5 || 0 = ")
(print r1)
(print "\n")

(let r2 int (|| 0 0))
(print "0 || 0 = ")
(print r2)
(print "\n")

(let r3 int (|| 3 7))
(print "3 || 7 = ")
(print r3)
(print "\n")

// && tests
(let r4 int (&& a b))
(print "0 && 5 = ")
(print r4)
(print "\n")

(let r5 int (&& 1 1))
(print "1 && 1 = ")
(print r5)
(print "\n")

(let r6 int (&& 3 0))
(print "3 && 0 = ")
(print r6)
(print "\n")

// Mixed
(let x int 10)
(let r7 int (&& (> x 5) (< x 20)))
(print "(10>5) && (10<20) = ")
(print r7)
(print "\n")

(let r8 int (|| (= x 0) (> x 15)))
(print "(10=0) || (10>15) = ")
(print r8)
(print "\n")

(let r9 int (|| (= x 0) (> x 5)))
(print "(10=0) || (10>5) = ")
(print r9)
(print "\n")

(print "=== Done ===\n")
