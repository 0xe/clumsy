// Simple TCP client using SDL_net
(extern SDL_Init [uint32_t] int)
(extern SDLNet_Init [] int)
(extern SDLNet_Quit [] void)
(extern SDLNet_ResolveHost [*void *char uint16_t] int)
(extern SDLNet_TCP_Open [*void] *void)
(extern SDLNet_TCP_Close [*void] void)
(extern SDL_Delay [uint32_t] void)
(extern SDL_Quit [] void)

// Constants
(let SDL_INIT_VIDEO int 0)
(let PORT uint16_t 8080)

// Initialize systems
(let sdl_result int (SDL_Init SDL_INIT_VIDEO))
(let net_result int (SDLNet_Init))

(if (= net_result 0)
  (begin
    (print "TCP Client starting...")
    
    // Connect to localhost on port 8080
    (let ip void null)
    (let resolve_result int (SDLNet_ResolveHost ip "127.0.0.1" PORT))
    
    (if (= resolve_result 0)
      (begin
        (let client_socket *void (SDLNet_TCP_Open ip))
        (if (!= client_socket null)
          (begin
            (print "Connected to server!")
            (SDL_Delay 1000)  // Stay connected for 1 second
            (SDLNet_TCP_Close client_socket)
            (print "Disconnected from server")
          )
          (print "Failed to connect to server (is server running?)")
        )
      )
      (print "Failed to resolve localhost")
    )
    
    (SDLNet_Quit)
  )
  (print "SDLNet initialization failed")
)

(SDL_Quit)