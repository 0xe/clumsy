(extern print_int [long] void)
(extern print_str [(* char)] void)

(print_str "=== Multi-argument test ===\n")
(print_str "Testing multiple calls:\n")
(print_str "Arg 1: ")
(print_int 42)
(print_str "\nArg 2: ")
(print_int 100)
(print_str "\nArg 3: ")
(print_int 255)
(print_str "\nTest completed!\n")
