// Test C-interop and pointer types (compile-smoke only)

// Declare C functions
(extern printf [(* char) int] int)
(extern malloc [int] (* int))

// Test pointer variable
(let ptr (* int) 0)
(let x int 42)

// Test address-of operator
(set ptr (& x))

// Test dereference operator
(let y int (* ptr))

// Call C function
(printf "Hello from C! x = %d, y = %d\n" x y)
